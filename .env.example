# Copie este arquivo para ".env" e preencha. O arquivo .env não deve ir para o Git.

# --- E-mail (obrigatório para receber alertas) --------------------------------
# Gmail: ative a verificação em duas etapas e crie uma "senha de app" em
# https://myaccount.google.com/apppasswords . Use essa senha de 16 letras abaixo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=
# Para quem vai o alerta (vazio = o próprio SMTP_USER)
MAIL_TO=

# --- Painel --------------------------------------------------------------------
# Senha do painel (usuário: qualquer um). Obrigatória no Docker.
PANEL_PASSWORD=troque-esta-senha
# PANEL_PORT=8787

# --- Opcional --------------------------------------------------------------------
# Chave da CSFloat (csfloat.com > perfil > Developers). Com ela a CSFloat passa de
# preço de referência (1 vez por hora) para anúncios individuais a cada minuto.
CSFLOAT_API_KEY=
# Limite de segurança de e-mails de alerta por hora
# MAX_EMAILS_PER_HOUR=30
# Pasta dos dados (banco e e-mails gravados quando não há SMTP)
# SKINMON_DATA=data
# Opcional: chave da Pricempire (pricempire.com, plano Trader gratuito) para acompanhar o CS.MONEY.
PRICEMPIRE_API_KEY=
